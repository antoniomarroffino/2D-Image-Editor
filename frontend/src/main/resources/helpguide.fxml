<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="helpGuideAnchorPane" prefHeight="400.0" prefWidth="600.0" stylesheets="@style/dark-theme.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <Label contentDisplay="CENTER" layoutX="235.0" prefHeight="42.0" prefWidth="130.0" text="Help guide" textAlignment="CENTER">
        <font>
            <Font name="System Bold" size="24.0" />
        </font>
    </Label>
    <Button fx:id="buttonClose" layoutX="266.0" layoutY="350.0" mnemonicParsing="false" prefHeight="42.0" prefWidth="67.0" text="Close" textAlignment="CENTER">
        <textFill>
            <RadialGradient centerX="0.5" centerY="0.5" radius="0.5">
                <stops>
                    <Stop>
                        <color>
                            <Color />
                        </color>
                    </Stop>
                    <Stop offset="1.0">
                        <color>
                            <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                    </Stop>
                </stops>
            </RadialGradient>
        </textFill>
    </Button>
   <TextArea text="%HelpGuide.guide" wrapText="true" layoutY="47.0" prefHeight="294.0" prefWidth="600.0" />
</AnchorPane>
