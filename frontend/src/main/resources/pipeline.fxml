<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<Pane fx:id="pipelinePane" prefHeight="450.0" prefWidth="204.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1">
    <HBox fillHeight="false" prefHeight="42.0" prefWidth="204.0" spacing="20.0"> <!-- Usa HBox per allineare Label e Button orizzontalmente -->
        <Label alignment="CENTER" contentDisplay="CENTER" prefHeight="42.0" prefWidth="128.0" text="Pipeline">
            <font>
                <Font name="Dubai Light" size="18.0" />
            </font>
        </Label>
        <!-- Aggiungi il pulsante di riproduzione -->
        <Button fx:id="playButton" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" prefHeight="41.0" prefWidth="46.0" styleClass="play-button">
            <graphic>
                <ImageView fx:id="playIcon" fitHeight="30.0" fitWidth="30.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@img/play.png" /> <!-- Inserisci il percorso corretto per l'icona -->
                    </image>
                </ImageView>
            </graphic>
         <HBox.margin>
            <Insets />
         </HBox.margin>
        </Button>
    </HBox>
    <ScrollPane fx:id="pipelineScrollPane" hbarPolicy="NEVER" layoutX="2.0" layoutY="41.0" prefHeight="407.0" prefWidth="200.0">
        <VBox fx:id="pipelineVBox" prefHeight="408.0" prefWidth="186.0" />
    </ScrollPane>
</Pane>
